APP_NAME="Real Props"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=real_props
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — local dev: log driver; docker: Mailhog (UI http://localhost:8025, SMTP :1025)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@realprops.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Real Props ---

# Search (Laravel Scout). "collection" works with no external service.
# Alternatives: database, algolia, meilisearch, typesense, turbopuffer
SCOUT_DRIVER=collection
SCOUT_QUEUE=false
SCOUT_PREFIX=

# Meilisearch (used when SCOUT_DRIVER=meilisearch; docker-compose ships a server)
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# Stripe (Laravel Cashier) — agent subscriptions. Leave blank to disable billing.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Cashier billing currency (ISO 4217)
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

# Require agents to verify their email before listing publicly (true/false)
APP_REQUIRE_EMAIL_VERIFICATION_FOR_AGENTS=true

# Google reCAPTCHA v3 on public forms (optional)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Media (Spatie Media Library)
MEDIA_DISK=public
MEDIA_QUEUE=false
