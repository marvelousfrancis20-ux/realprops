# Environment used by docker-compose (copy/adjust per deployment).
# Secrets must be overridden in production via a real secrets manager or CI env.

APP_NAME="Real Props"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=real_props
DB_USERNAME=realprops
DB_PASSWORD=secret

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

SCOUT_DRIVER=database
SCOUT_QUEUE=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@realprops.test"
MAIL_FROM_NAME="${APP_NAME}"

# Docker entrypoint behaviour
GENERATE_APP_KEY=true
RUN_MIGRATIONS=true
OPTIMIZE=true
